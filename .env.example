NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key
# 커스텀 서브도메인 배포 구조(app.example.com/api.example.com)를 로컬에서부터 맞추기 위해
# api.localhost를 쓴다 (Chrome/Firefox가 *.localhost를 127.0.0.1로 자동 해석 — hosts 수정 불필요).
# 이 값을 쓰려면 프론트도 http://localhost:3000이 아니라 http://app.localhost:3000으로 접속해야 한다.
NEXT_PUBLIC_API_BASE_URL=http://api.localhost:8080
NEXT_PUBLIC_USE_MOCK_DATA=true
